.shirones/

# 内容仓工作副本与备份
.content-src/
.content-backup/
content.lock.json

# 生成的类型
.astro/

# 依赖
node_modules/

# 日志
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 环境变量
.env
.env.production

# 系统文件
.DS_Store

# 锁文件（保留 pnpm-lock.yaml）
package-lock.json
yarn.lock
bun.lockb

# 编辑器
.idea/
.vscode/
*.iml

# 生成的字体子集与图标集合
src/assets/fonts/.subset/
src/generated/

