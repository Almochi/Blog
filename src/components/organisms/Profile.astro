---
import { getImage } from "astro:assets";
import Button from "@components/atoms/action/Button.svelte";
import IconButton from "@components/atoms/action/IconButton.svelte";
import Avatar from "@components/atoms/display/Avatar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import Tooltip from "@components/atoms/overlay/Tooltip.svelte";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
// 等价于主题内部对 `@iconify/svelte` 的别名，但可在项目内通过 tsconfig 别名解析。
import Icon from "@components/atoms/display/Icon.svelte";
import { resolveImageAsset } from "@utils/asset-utils";
import { url } from "@utils/url-utils";
import { profileConfig } from "@/config";
import type { ProfileWidget } from "@/types/sidebarConfig";

interface Props {
	class?: string;
	style?: string;
	widget?: ProfileWidget;
	priority?: boolean;
}

const className = Astro.props.class;
const style = Astro.props.style;
const priority = Astro.props.priority ?? false;

const config = profileConfig;
const avatarAsset = await resolveImageAsset(config.avatar ?? "");
let avatarUrl = typeof avatarAsset === "string" ? avatarAsset : avatarAsset.src;
let avatarSrcset: string | undefined;
let avatarWidth: number | undefined;
let avatarHeight: number | undefined;
if (typeof avatarAsset !== "string") {
	const widths = [128, 256, 384, 512].filter(
		(width) => width <= avatarAsset.width,
	);
	const candidates = await Promise.all(
		widths.map(async (width) => ({
			width,
			image: await getImage({
				src: avatarAsset,
				width,
				format: "webp",
				quality: 72,
			}),
		})),
	);
	avatarUrl =
		candidates.find(({ width }) => width === 256)?.image.src ??
		candidates.at(-1)?.image.src ??
		avatarAsset.src;
	avatarSrcset = candidates
		.map(({ image, width }) => `${image.src} ${width}w`)
		.join(", ");
	avatarWidth = avatarAsset.width;
	avatarHeight = avatarAsset.height;
}
// 项目补充：这两个图标不在主题包内置的运行时图标集合中（包模式下集合来自包内快照），
// 主题的 <Icon> 因此会渲染为空。这里以内联 SVG 兜底，其余图标仍交给 <Icon>。
const projectIcons: Record<string, { viewBox: string; body: string }> = {
	"fa7-brands:bilibili": { viewBox: "0 0 640 640", body: "<path fill=\"currentColor\" d=\"M552.6 168.1c16.7 18.1 24.4 39.7 23.3 65.7v202.4c-.4 26.4-9.2 48.1-26.5 65.1c-17.2 17-39.1 25.9-65.5 26.7H156c-26.4-.8-48.2-9.8-65.3-27.2s-26-40.3-26.7-68.6V233.8c.8-26 9.7-47.6 26.7-65.7c17.1-16.3 38.8-25.3 65.3-26.1h29.4L160 116.2c-5.7-5.7-8.6-13-8.6-21.8s2.9-16.1 8.6-21.8s13-8.6 21.9-8.6s16.1 2.9 21.9 8.6l73.3 69.4h88l74.5-69.4c6.1-5.7 13.6-8.6 22.4-8.6s16.1 2.9 21.9 8.6c5.7 5.7 8.6 13 8.6 21.8s-2.9 16.1-8.6 21.8L458.6 142h29.3c26.4.8 48 9.8 64.7 26.1m-38.8 69.7c-.4-9.6-3.7-17.4-10.7-23.5c-5.2-6.1-14-9.4-22.7-9.8H160c-9.6.4-17.4 3.7-23.6 9.8c-6.1 6.1-9.4 13.9-9.8 23.5v194.4c0 9.2 3.3 17 9.8 23.5s14.4 9.8 23.6 9.8h320.4c9.2 0 17-3.3 23.3-9.8s9.7-14.3 10.1-23.5zm-264.3 42.7c6.3 6.3 9.7 14.1 10.1 23.2V337c-.4 9.2-3.7 16.9-9.8 23.2c-6.2 6.3-14 9.5-23.6 9.5s-17.5-3.2-23.6-9.5s-9.4-14-9.8-23.2v-33.3c.4-9.1 3.8-16.9 10.1-23.2s13.2-9.6 23.3-10c9.2.4 17 3.7 23.3 10m191.5 0c6.3 6.3 9.7 14.1 10.1 23.2V337c-.4 9.2-3.7 16.9-9.8 23.2s-14 9.5-23.6 9.5s-17.4-3.2-23.6-9.5c-7-6.3-9.4-14-9.7-23.2v-33.3c.3-9.1 3.7-16.9 10-23.2s14.1-9.6 23.3-10c9.2.4 17 3.7 23.3 10\"/>" },
	"material-symbols:mail-outline-rounded": { viewBox: "0 0 24 24", body: "<path fill=\"currentColor\" d=\"M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h16q.825 0 1.413.588T22 6v12q0 .825-.587 1.413T20 20zM20 8l-7.475 4.675q-.125.075-.262.113t-.263.037t-.262-.037t-.263-.113L4 8v10h16zm-8 3l8-5H4zM4 8v.25v-1.475v.025V6v.8v-.012V8.25zv10z\"/>" },
};

---
<div class={className} style={style}>
	<Card color="var(--card-bg)" radius="l" class="m3-profile p-3">
    <a aria-label={i18n(I18nKey.goToAboutPage)} href={url('/about/')}
       class="m3-profile__avatar-link group">
        <div class="m3-profile__avatar-overlay">
            <Icon icon="fa7-solid:address-card"
                  class="m3-profile__avatar-icon" />
        </div>
        <Avatar
            src={avatarUrl}
			srcset={avatarSrcset}
			sizes="(min-width: 1024px) 256px, 176px"
			width={avatarWidth}
			height={avatarHeight}
			loading={priority ? "eager" : "lazy"}
			fetchPriority={priority ? "high" : undefined}
            alt="Profile Image of the Author"
            size={176}
            shape="rounded"
            class="mx-auto lg:!w-full"
        />
    </a>
    <div class="m3-profile__info px-2">
        <div class="m3-profile__name">{config.name}</div>
        <div class="m3-profile__accent"></div>
        <div class="m3-profile__bio">{config.bio}</div>
        <div class="m3-profile__links flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                <Tooltip label={item.name} placement="top" client:load>
                    <IconButton href={item.url} target="_blank" rel="me" label={item.name}>
                        {projectIcons[item.icon] ? <svg class="text-[1.5rem]" width="1em" height="1em" viewBox={projectIcons[item.icon].viewBox} aria-hidden="true" set:html={projectIcons[item.icon].body} /> : <Icon icon={item.icon} class="text-[1.5rem]"></Icon>}
                    </IconButton>
                </Tooltip>
            )}
            {config.links.length == 1 && <Button href={config.links[0].url} target="_blank" ariaLabel={config.links[0].name}
                                                 variant="text" size="small" class="!px-3 !font-bold !text-[var(--on-surface)]">
                {projectIcons[config.links[0].icon] ? <svg class="text-[1.5rem]" width="1em" height="1em" viewBox={projectIcons[config.links[0].icon].viewBox} aria-hidden="true" set:html={projectIcons[config.links[0].icon].body} /> : <Icon icon={config.links[0].icon} class="text-[1.5rem]"></Icon>}
                {config.links[0].name}
            </Button>}
        </div>
        <UmamiStats variant="profile" />
    </div>
	</Card>
</div>

<style lang="stylus">
.m3-profile
	&__avatar-link
		display: block
		position: relative
		margin: var(--m3e-space-1) auto var(--m3e-space-3)
		max-width: 12rem
		border-radius: var(--shape-corner-m)
		overflow: hidden
		transition:
			transform var(--m3e-duration-short) var(--m3e-easing-standard),
			box-shadow var(--m3e-duration-short) var(--m3e-easing-standard)
		&:focus-visible
			outline: 2px solid var(--primary)
			outline-offset: 2px
		@media (min-width: 1024px)
			max-width: none
			margin-top: 0

	&__avatar-overlay
		position: absolute
		inset: 0
		z-index: 10
		display: flex
		align-items: center
		justify-content: center
		pointer-events: none
		transition: background-color var(--m3e-duration-medium) var(--m3e-easing-standard)
		.group:hover &
			background-color: rgba(0, 0, 0, 0.3)
		.group:active &
			background-color: rgba(0, 0, 0, 0.5)

	&__avatar-icon
		color: #fff
		font-size: 3rem
		opacity: 0
		transform: scale(0.9)
		transition:
			opacity var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate),
			transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)
		.group:hover &
			opacity: 1
			transform: scale(1)

	&__name
		font: var(--m3e-type-title-large)
		font-weight: 700
		text-align: center
		margin: 0 0 var(--m3e-space-1)
		color: var(--on-surface)
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)

	&__accent
		width: 1.25rem
		height: 0.25rem
		background: var(--primary)
		border-radius: var(--shape-corner-full)
		margin: 0 auto var(--m3e-space-2)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)

	&__bio
		font: var(--m3e-type-body-medium)
		color: var(--on-surface-variant)
		text-align: center
		margin: 0 0 var(--m3e-space-3)
		line-height: 1.5
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
</style>
